{
  "$schema": "https://app.deessejs.com/schema/template/v1.json",
  "formatVersion": 1,
  "name": "documentation-template",
  "title": "Docs Starter",
  "description": "Documentation site starter built on Next.js 16 + Fumadocs. MDX content, Orama search, OG images, LLM endpoints, Tailwind v4.",
  "version": "1.0.0",
  "type": "template:starter",
  "author": "DeesseJS <hello@deessejs.com>",
  "license": "MIT",
  "category": "docs",
  "labels": [
    "fumadocs",
    "mdx",
    "nextjs",
    "llms"
  ],
  "source": {
    "repo": "deessejs/documentation-template"
  },
  "includes": [
    "**/*"
  ],
  "excludes": [
    "deesse-template.json",
    ".changeset/**",
    ".claude/**",
    ".codex/**",
    ".github/ISSUE_TEMPLATE/**",
    ".github/CODEOWNERS",
    ".github/FUNDING.yml",
    ".github/PULL_REQUEST_TEMPLATE.md",
    "docs/**",
    "CHANGELOG.md",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/.DS_Store",
    ".env",
    "**/.env",
    ".env.local",
    "**/.env.local",
    ".env.*.local",
    "**/.env.*.local",
    ".env.development",
    "**/.env.development",
    ".env.production",
    "**/.env.production",
    ".env.test",
    "**/.env.test"
  ]
}
